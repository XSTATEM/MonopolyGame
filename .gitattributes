# Скрипты и конфиги для Linux-сервера — всегда с LF, иначе bash/systemd/nginx их не поймут.
*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
deploy/*.conf text eol=lf
Dockerfile text eol=lf
# Windows PowerShell 5.1 читает скрипт без BOM как ANSI — deploy.ps1 хранится в UTF-8 с BOM и CRLF.
*.ps1      text eol=crlf
